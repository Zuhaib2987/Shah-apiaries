# Copy to .dev.vars for local development (never commit .dev.vars).
# Razorpay TEST keys from dashboard.razorpay.com > Account & Settings > API Keys (Test mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=choose-any-long-random-text
# Any long random text (40+ characters)
SESSION_SECRET=replace-with-a-long-random-string-at-least-40-characters
# Output of: npm run hash-password -- <username> <password>
ADMIN_USERS={"zuhaib":"pbkdf2_sha256$100000$...$..."}
