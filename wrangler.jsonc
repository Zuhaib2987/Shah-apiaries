{
  // Shah Apiaries on Cloudflare Workers.
  // Static site in ./public, API in ./src, orders in a D1 database.
  "name": "shah-apiaries",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shah-apiaries",
      "database_id": "aac9cb55-bb5c-4dd0-b76c-9e787de2b26c",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "SITE_URL": "https://shahapiaries.in"
  },
  "observability": { "enabled": true },
  // Keep variables added in the Cloudflare dashboard when deploying from GitHub.
  "keep_vars": true
  // Secrets (set in Cloudflare dashboard, never in this file):
  //   RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET,
  //   SESSION_SECRET, ADMIN_USERS
}
