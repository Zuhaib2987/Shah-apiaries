{
  // Shah Apiaries on Cloudflare Workers.
  // Static site in ./public, API in ./src, orders in a D1 database.
  "name": "shah-apiaries",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shah-apiaries",
      // Paste the ID shown after creating the database (see README, step 3).
      "database_id": "PASTE_D1_DATABASE_ID_HERE",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "SITE_URL": "https://shahapiaries.in"
  },
  "observability": { "enabled": true }
  // Secrets (set in Cloudflare dashboard, never in this file):
  //   RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET,
  //   SESSION_SECRET, ADMIN_USERS
}
